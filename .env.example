# Copy to .env. Everything commented out is optional, and shows its default.

### Required

# the account the ingester polls e621 with. everything it can see is sent out publicly, so don't use one with staff permissions
E621_AUTH_USER=
E621_AUTH_KEY=

# oauth tokens are encrypted with these, and session & gateway tokens are fingerprinted with the hmac key.
# changing them logs everyone out and breaks every stored token. make each with: openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_SALT=
HMAC_KEY=

# docker compose uses these for the port mappings and health checks, so they have to be set
HTTP_PORT=4000
GATEWAY_PORT=4001
EGRESS_PORT=4002

DATABASE_URL=postgresql://e621stream:@postgres.e621stream.containers.local:5432/e621stream?sslmode=disable
REDIS_URL=redis://redis.e621stream.containers.local:6379/0

### Website

# PUBLIC_URL=https://e621.stream
# PUBLIC_WS_URL=wss://e621.stream/ws
# client ips come from CF-Connecting-IP/X-Forwarded-For, and https from X-Forwarded-Proto. only turn on behind a proxy that sets them
# TRUST_PROXY=false
# SESSION_LENGTH=24 # hours, how long logins on the site last
# MAX_TOKENS_PER_USER=10 # gateway tokens each user can have

# logging in with e621, and private events through gateway tokens. both need these
# E621_OAUTH_CLIENT_ID=
# E621_OAUTH_CLIENT_SECRET=
# E621_OAUTH_REDIRECT_URI=<PUBLIC_URL>/user/login/oauth/callback

### Gateway

# WS_AUTH_REQUIRED=true
# WS_IDLE_TIMEOUT=120 # seconds without a message before a connection is closed
# IDENTIFY_TIMEOUT=10000 # ms
# MAX_CONNECTIONS_PER_IP=10 # per gateway
# MAX_CONNECTIONS_PER_USER=10 # per gateway
# MAX_SUBSCRIPTIONS=50
# MAX_CLIENT_MESSAGES_PER_MINUTE=60 # the default, admins can change it per user
# MAX_SNAPSHOT_IDS=1000 # per snapshot request
# SNAPSHOT_CHUNK_SIZE=1000 # ids per snapshot message
# MAX_BUFFERED_BYTES=16777216 # a client this far behind is disconnected
# REPLAY_BATCH_SIZE=500
# AUTH_CACHE_SECONDS=1800 # api key checks are cached this long
# SESSION_RECHECK_INTERVAL=60000 # ms, how often connected sessions' credentials are checked again

### Stream

# REPLAY_LIMIT=2000000 # events kept for replaying
# REPLAY_PERIOD=0 # hours, 0 keeps them until REPLAY_LIMIT

### Ingester

# BACKFILL=false # store everything from before the feeds started, through the api
# DISABLED_SOURCES= # feeds to not run, comma separated (like comments,blips)
# POLL_INTERVAL_SCALE=1 # every feed's interval is multiplied by this
# IDLE_POLL_SCALE=10 # how much slower feeds go while nobody's connected and the backfill is running

# e621 allows 2 requests a second. every process shares these through redis
# E621_REQUEST_INTERVAL=550 # ms between requests
# E621_AUTH_REQUEST_INTERVAL=1000 # ms, for credential checks
# E621_PRIVATE_REQUEST_INTERVAL=1000 # ms, for private events
# E621_PRIVATE_POLL_INTERVAL=60000 # ms, how often each user's private events are checked
# E621_BASE_URL=https://e621.net
# E621_USER_AGENT=E621Stream/<version> (by Donovan_DMC; +<PUBLIC_URL>)

# egress proxies requests go through, comma separated (like http://egress-1.e621stream.containers.local:4002)
# E621_EGRESS_PROXIES=
# E621_EGRESS_FAMILY=4 # the ip version egress connects to e621 over, 4 or 6
# E621_DIRECT_FALLBACK_ONLY=false # only go through the egress proxies, never direct. needs E621_EGRESS_PROXIES

### Monitoring

# posted to when e621's median request time over 5 minutes reaches LATENCY_ALERT_MS, and when it recovers
# DISCORD_NOTIFICATION_WEBHOOK_URL=
# DISCORD_WEBHOOK_BASE=https://discord.com
# LATENCY_ALERT_MS=2000

### Other

# REDIS_PREFIX=e621stream: # put before every key
# LOG_DIR=logs
# LOG_EVENTS=true # log every event sent, to events-<service>.log
# LOGGER=* # which debug logs to print, comma separated (like gateway,ingester:*)
