# the account the ingester polls e621 with. everything it can see is rebroadcast publicly,
# so use a normal account without staff permissions
E621_AUTH_USER=
E621_AUTH_KEY=
# E621_USER_AGENT=E621Stream/0.0.0 (by Donovan_DMC; +https://e621.stream)

# ingester
# E621_REQUEST_INTERVAL_MS=550
# E621_AUTH_REQUEST_INTERVAL_MS=1000
# DISABLED_SOURCES=mod_actions,tag_type_versions
# POLL_INTERVAL_SCALE=1
# LOG_DIR=logs
# LOG_RETENTION_DAYS=14
# RETENTION_HOURS=24
# MAX_STREAM_LENGTH=2000000
# POST_SNAPSHOT_TTL_SECONDS=604800
# UPDATE_SNAPSHOT_TTL_SECONDS=2592000

# gateway
# PUBLIC_URL=wss://e621.stream/ws
# AUTH_REQUIRED=true
# AUTH_CACHE_SECONDS=1800
# MAX_CONNECTIONS_PER_IP=10
# MAX_CONNECTIONS_PER_USER=5
# MAX_SUBSCRIPTIONS=50
# MAX_CLIENT_MESSAGES_PER_MINUTE=60
# MAX_BUFFERED_BYTES=16777216
# IDENTIFY_TIMEOUT_MS=10000
